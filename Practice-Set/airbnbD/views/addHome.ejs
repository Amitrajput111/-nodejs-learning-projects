<%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main class="container mx-auto px-4 py-10 max-w-xl">
      <section class="bg-white rounded-lg shadow-lg p-8">
        <h1 class="text-3xl font-bold mb-2 text-center text-gray-800">
          Register Your Home
        </h1>
        <p class="text-center text-gray-500 mb-6">
          Share your property with guests on Airbnb.
        </p>

        <% if (error) { %>
          <p
            class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-red-700 text-sm"
            role="alert"
          >
            <%= error %>
          </p>
        <% } %>

        <form action="/host/add-home" method="POST" class="space-y-4">
          <div>
            <label for="houseName" class="block text-sm font-medium text-gray-700 mb-1">
              House name
            </label>
            <input
              id="houseName"
              type="text"
              name="houseName"
              value="<%= houseName %>"
              placeholder="e.g. Sunset Villa"
              required
              maxlength="100"
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-200 font-medium"
          >
            Submit listing
          </button>
        </form>
      </section>
    </main>
  </body>
</html>
