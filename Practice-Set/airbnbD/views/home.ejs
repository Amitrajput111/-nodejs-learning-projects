<%- include('partials/head') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <main class="container mx-auto px-4 py-10 max-w-2xl">
      <section class="bg-white shadow-lg rounded-lg p-8">
        <h1 class="text-3xl text-red-500 font-bold text-center mb-2">
          Registered Homes
        </h1>
        <p class="text-center text-gray-500 mb-8">
          Browse homes listed by our hosts.
        </p>

        <% if (registeredHomes.length === 0) { %>
          <div class="text-center py-8 border-2 border-dashed border-gray-200 rounded-lg">
            <p class="text-gray-600 mb-4">No homes registered yet.</p>
            <a
              href="/host/add-home"
              class="inline-block bg-red-500 text-white py-2 px-5 rounded-md hover:bg-red-600 transition duration-200"
            >
              Add the first home
            </a>
          </div>
        <% } else { %>
          <ul class="space-y-4">
            <% registeredHomes.forEach((home) => { %>
              <li
                class="bg-gray-50 p-4 rounded-lg border border-gray-100 hover:shadow-md transition duration-200"
              >
                <span class="text-lg font-medium text-gray-800"><%= home.houseName %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </main>
  </body>
</html>
